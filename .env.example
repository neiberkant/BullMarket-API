# trading_assistant_api/.env.example

# Playwright Settings
PLAYWRIGHT_HEADLESS=True
PLAYWRIGHT_DEFAULT_TIMEOUT=60000

# IOL API Credentials (If used)
IOL_API_USER=""
IOL_API_PASSWORD=""

# Google Cloud / Sheets API
GOOGLE_SHEET_ID=""
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_API_CREDENTIALS_PATH="/app/google_credentials.json"

# --- Configuración de Google Gemini ---
GEMINI_API_KEY="" # Ingresa tu API Key de Google AI Studio
GEMINI_MODEL_NAME="gemini-2.0-flash" 
PROMPT_FILE_GEMINI="/app/prompts/finanzas_prompts.txt"

# Parámetros de Generación de Gemini
GEMINI_TEMPERATURE=0.5
GEMINI_TOP_P=0.9
GEMINI_TOP_K=32
GEMINI_MAX_OUTPUT_TOKENS=65536
GEMINI_REQUEST_TIMEOUT=720

# Evolution API (WhatsApp)
EVOLUTION_API_URL="" # Ejemplo: https://api.tu-servidor.com
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_ID=""
EVOLUTION_SENDER_PHONE="" 
WHATSAPP_TIMEOUT_REQUEST=30

# Email (SMTP)
EMAIL_SMTP_SERVER="smtp.gmail.com"
EMAIL_SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM_ADDRESS=""
EMAIL_RECIPIENT_DEFAULT=""
EMAIL_USE_TLS=True
SMTP_TIMEOUT_S=30

# Configuración de Rutas y Proyecto
PROJECT_NAME="BullMarket API"
PROJECT_VERSION="1.0"
PROJECT_DESCRIPTION="La API para BullMarket líder en automatización de trading con Inteligencia Artificial"
DATA_PATH="/app/data"
SCRAPED_REPORTS_PATH="${DATA_PATH}/scraped_reports"
AUDIO_REPORTS_PATH="${DATA_PATH}/audio_reports"

# URLs de Scrapeo (Predeterminadas)
BACS_BASE_URL="https://bacs.com.ar/"
ARGOB_INFORMES_URL="https://www.argentina.gob.ar/informes-del-mercado-case-capitales"
BALANZ_DAILY_REPORTS_URL="https://balanz.com/reportes/daily/"
PP_BASE_URL="https://www.portfoliopersonal.com/"
PP_INFORMES_URL="https://www.portfoliopersonal.com/research/informes"
DOLARITO_RIESGO_PAIS_URL="https://www.dolarito.ar/indices/riesgo-pais"
BULLMARKET_COMMISSIONS_URL="https://help.bullmarketbrokers.com/guia/comisiones/"

# Credenciales de BullMarket
BULLMARKET_EMAIL=""
BULLMARKET_PASSWORD=""

# Destinatario predeterminado para alertas WhatsApp
WHATSAPP_RECIPIENT_NUMBER_DEFAULT=""
